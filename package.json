{
  "name": "pi-config",
  "private": true,
  "type": "module",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": [
      "extensions/ask-user/index.ts",
      "extensions/ui-dashboard.ts",
      "extensions/dag-workflows.ts",
      "extensions/subagents/index.ts",
      "extensions/delegation-gate.ts"
    ]
  },
  "scripts": {
    "test": "pnpm run test:core && pnpm run test:subagents",
    "test:core": "tsx --test lib/**/*.test.ts extensions/delegation-gate.test.ts extensions/ask-user/ask-user.test.ts",
    "test:subagents": "tsx --test extensions/subagents/manager.test.ts extensions/subagents/result-delivery.test.ts extensions/subagents/context-usage.test.ts extensions/subagents/takeover.test.ts",
    "test:subagents:live": "tsx --test extensions/subagents/claude.test.ts extensions/subagents/codex.test.ts extensions/subagents/grok.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.207",
    "@anthropic-ai/sdk": "0.111.0",
    "effect": "4.0.0-beta.97"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.80.6",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@earendil-works/pi-tui": "0.80.6",
    "@types/node": "24.12.4",
    "tsx": "4.23.0",
    "typebox": "1.1.38",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "packageManager": "pnpm@11.1.3"
}
