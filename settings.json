{
  "lastChangelogVersion": "0.80.6",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "compaction": {
    "enabled": true,
    "reserveTokens": 39000,
    "keepRecentTokens": 20000
  },
  "theme": "github-dark-default",
  "transport": "auto",
  "terminal": {
    "showTerminalProgress": true
  },
  "collapseChangelog": false,
  "showCacheMissNotices": true,
  "hideThinkingBlock": false,
  "packages": [
    {
      "source": "git:github.com/hhushhas/pi-subagents@5cccd64d39a2e6a95ed557bde24dfcac1f17309e",
      "prompts": []
    },
    {
      "source": "npm:@upstash/context7-pi@0.1.1",
      "prompts": []
    },
    {
      "source": "./packages/portable-pi-setup",
      "extensions": [
        "+extensions/ask-user/index.ts",
        "+extensions/dag-workflows.ts",
        "+extensions/subagents/index.ts",
        "+extensions/foreground-bash-policy.ts",
        "+extensions/background-terminals/index.ts",
        "+extensions/delegation-gate.ts",
        "+extensions/dcg-guard.ts",
        "+extensions/manual-only-skills.ts",
        "+extensions/openai-image-generation.ts",
        "+extensions/auto-name/index.ts"
      ],
      "skills": [
        "+skills/codex-review/SKILL.md",
        "+skills/skillbox/SKILL.md",
        "+skills/spec-craft/SKILL.md",
        "+skills/writing/SKILL.md"
      ],
      "prompts": [
        "+prompts/debrief.md",
        "+prompts/orchestrate.md"
      ],
      "themes": []
    },
    {
      "source": "git:github.com/davis7dotsh/my-pi-setup@8feb880c9275faaaccb9e4a00ec1ea800cfbfc9f",
      "extensions": [
        "!extensions/**",
        "+extensions/firecrawl-search/index.ts",
        "+extensions/git-info/index.ts",
        "+extensions/model-info/index.ts",
        "+extensions/ui-customization/index.ts"
      ],
      "skills": [],
      "prompts": [],
      "themes": [
        "+themes/github-dark-default.json"
      ]
    },
    "npm:pi-chrome@0.15.46"
  ],
  "subagents": {
    "maxSubagentSpawnsPerSession": 256,
    "agentOverrides": {
      "worker": {
        "defaultContext": "fresh",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write",
          "contact_supervisor",
          "bg_start",
          "bg_status",
          "bg_list",
          "bg_kill"
        ]
      },
      "researcher": {
        "disabled": true
      },
      "context-builder": {
        "disabled": true
      },
      "planner": {
        "disabled": true
      },
      "oracle": {
        "disabled": true
      },
      "delegate": {
        "disabled": true
      }
    }
  },
  "showHardwareCursor": true
}